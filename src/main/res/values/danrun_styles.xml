<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Abas em formato de "pílulas" -->
    <style name="DanRunTabs" parent="Widget.Material3.TabLayout">
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">start</item>
        <item name="tabIndicator">@drawable/danrun_tab_indicator</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorColor">#FF6A13</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabSelectedTextColor">#000000</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabPaddingStart">18dp</item>
        <item name="tabPaddingEnd">18dp</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabTextAppearance">@style/DanRunTabText</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="tabContentStart">4dp</item>
    </style>

    <style name="DanRunTabText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
