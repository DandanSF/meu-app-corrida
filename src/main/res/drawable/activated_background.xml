<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/opentracks_transparent" />
                <stroke android:width="2dp" android:color="?attr/colorPrimary" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/colorSurfaceContainer" />
                <stroke android:width="1dp" android:color="?attr/colorOutline" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
</selector>
